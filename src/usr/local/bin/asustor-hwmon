#!/bin/bash
# shellcheck disable=SC2254,SC2086,SC2034  # kept as written: tested behaviour (tests/test-leds.sh, run-tests.sh); globs and word splitting here are intended
# asustor-hwmon: read-only sensor logger for Asustor Control.
#
#  1. Summary CSV in RAM for the WebGUI chart (every 30 s, 12 h ring):
#       ts,pwm,cpu_max_c,drive_max_c,rpm
#  2. Detailed behaviour log (every 10 s), buffered in RAM and appended to
#     appdata every 5 min, one file per day, 30-day retention:
#       ts,pwm,rpm,pkg_c,core_max_c,cpu_khz,throttle_pkg,fcp_temp,fcp_src,nvme,disks
#     nvme  = "nvme0=40;nvme1=44"   (live, from the nvme hwmon sensors)
#     disks = "parity=42;disk1=40;...;flash=*"  (Unraid's disks.ini; * = unknown/spun down)
#     fcp_* = the temperature and source FanCtrl Plus acted on ("51 (CPU)")
#
#  3. PWM change events -> action.log (shown on the Status tab) and
#     $LOGDIR/pwm-events-YYYY-MM-DD.log, naming what FanCtrl Plus reacted to and
#     the processes that used the most CPU time / wrote the most I/O in the
#     interval before the change (the "offender"), with their Docker container.
#
# NEVER writes to any sysfs file. ASUSTOR_SYSROOT prefixes every absolute path
# (test hook); ASUSTOR_ONESHOT=1 prints one detailed row and exits;
# ASUSTOR_TEST_FN=flush_buffer|snapshot_procs|prune_logdir runs that one function and exits (tests).
#
# The log dir is on a user share, which may be writable over SMB/NFS, and the daemon runs as
# root: the day and events files are opened with O_NOFOLLOW through pinned dir fds (see
# logdir_op; retention too), so no symlink is ever followed; a failure is warned once and the rows
# stay buffered. The dir gets mode 755 only when the daemon creates it. Process names from /proc
# are reduced to [A-Za-z0-9._-] before they are logged.

R="${ASUSTOR_SYSROOT:-}"
STATE_DIR="$R/var/local/emhttp/plugins/asustor-control"
HISTORY="$STATE_DIR/hwmon-history.csv"
BUFFER="$STATE_DIR/hwlog-buffer.csv"
STATUS="$STATE_DIR/hwlog-status.json"
PIDFILE="$R/var/run/asustor-hwmon.pid"
ACTION_LOG="$STATE_DIR/action.log"
SNAP_DIR="$STATE_DIR/procsnap"   # ring of the last WINDOW_SNAPS process snapshots
WINDOW_SNAPS=6                    # 6 x 10 s = the controller's 60 s poll period
PROC="$R/proc"
LOGDIR="$R/mnt/user/appdata/asustor-control/hwlog"
DISKS_INI="$R/var/local/emhttp/disks.ini"
FCP_GLOB="$R/var/tmp/fanctrlplus/temp_*"
HWMON_GLOB="$R/sys/class/hwmon/hwmon*"
CPU_GLOB="$R/sys/devices/system/cpu/cpu[0-9]*"

INTERVAL=10          # detailed sample period, seconds
SUMMARY_EVERY=3      # every Nth sample also goes to the chart CSV (30 s)
MAX_LINES=1440       # chart ring: 12 h at 30 s
FLUSH_EVERY=30       # samples per appdata flush (5 min)
BUFFER_MAX=8640      # 1 day of samples kept if appdata is unavailable
RETAIN_DAYS=30
CLK_TCK=$(getconf CLK_TCK 2>/dev/null || echo 100)
NCPUS=$(nproc 2>/dev/null || echo 1)
declare -A CONTAINER_OF   # cgroup id -> container name (filled lazily via docker ps)
HEADER="ts,pwm,rpm,pkg_c,core_max_c,cpu_khz,throttle_pkg,fcp_temp,fcp_src,nvme,disks,cpu_busy_pct"

mkdir -p "$STATE_DIR" "$SNAP_DIR" "$(dirname "$PIDFILE")"

# --- sensor discovery -------------------------------------------------------
find_hwmon_named() {           # $1 = glob pattern for the chip name
    local h
    for h in $HWMON_GLOB; do
        case "$(cat "$h/name" 2>/dev/null)" in $1) echo "$h"; return 0;; esac
    done
    return 1
}

read_int() {                   # print integer content of $1 or "" if absent/non-numeric
    local v; v=$(cat "$1" 2>/dev/null); [[ "$v" =~ ^-?[0-9]+$ ]] && echo "$v"
}

read_cpu_temps() {             # sets PKG_C and CORE_MAX_C from coretemp
    PKG_C=""; CORE_MAX_C=""
    [ -n "$CT" ] || return
    local f v label max=0
    for f in "$CT"/temp*_input; do
        [ -f "$f" ] || continue
        v=$(read_int "$f") || continue
        v=$(( v / 1000 ))
        label=$(cat "${f%_input}_label" 2>/dev/null)
        if [[ "$label" == Package* ]]; then PKG_C=$v; fi
        (( v > max && v < 120 )) && max=$v
    done
    (( max > 0 )) && CORE_MAX_C=$max
}

read_cpu_khz() {               # highest current core frequency
    local c v max=0
    for c in $CPU_GLOB; do
        v=$(read_int "$c/cpufreq/scaling_cur_freq") || continue
        (( v > max )) && max=$v
    done
    (( max > 0 )) && echo "$max"
}

read_busy_pct() {             # sets BUSY = whole-system CPU busy % since the previous call (/proc/stat)
    local line total idle
    BUSY=""
    read -r line < "$PROC/stat" || return
    set -- $line
    total=$(( $2 + $3 + $4 + $5 + $6 + $7 + $8 )); idle=$(( $5 + $6 ))
    if [ -n "${PREV_STAT_TOTAL:-}" ] && (( total > PREV_STAT_TOTAL )); then
        BUSY=$(( 100 * ((total - PREV_STAT_TOTAL) - (idle - PREV_STAT_IDLE)) / (total - PREV_STAT_TOTAL) ))
    fi
    PREV_STAT_TOTAL=$total; PREV_STAT_IDLE=$idle
}

read_throttle() {              # package-level throttle event counter (cumulative)
    local c
    for c in $CPU_GLOB; do
        read_int "$c/thermal_throttle/package_throttle_count" && return
    done
}

read_fcp() {                   # sets FCP_TEMP and FCP_SRC from FanCtrl Plus' state file
    FCP_TEMP=""; FCP_SRC=""
    local f line
    for f in $FCP_GLOB; do
        [ -f "$f" ] || continue
        line=$(cat "$f" 2>/dev/null)
        [[ "$line" =~ ^([0-9*]+)[[:space:]]*\(?([A-Za-z]*)\)? ]] && { FCP_TEMP=${BASH_REMATCH[1]}; FCP_SRC=${BASH_REMATCH[2]}; }
        return
    done
}

read_nvme() {                  # "nvme0=40;nvme1=44"
    local h dev v out=""
    for h in $HWMON_GLOB; do
        [ "$(cat "$h/name" 2>/dev/null)" = "nvme" ] || continue
        dev=$(basename "$(readlink -f "$h/device" 2>/dev/null)")
        v=$(read_int "$h/temp1_input") || continue
        out+="${dev:-?}=$(( v / 1000 ));"
    done
    echo "${out%;}"
}

read_disks() {                 # sets DISKS ("parity=42;disk1=40;...") and DRIVE_MAX_C
    DISKS=""; DRIVE_MAX_C=0
    [ -f "$DISKS_INI" ] || return
    local out
    out=$(awk -F= '
        /^\[/ { if (name != "") printf "%s=%s;", name, temp; name=""; temp="*" }
        /^name=/ { gsub(/"/, "", $2); name=$2 }
        /^temp=/ { gsub(/"/, "", $2); temp=$2; if (temp ~ /^[0-9]+$/ && temp+0 > m) m=temp+0 }
        END { if (name != "") printf "%s=%s;", name, temp; printf "\n%d\n", m }' "$DISKS_INI")
    DISKS=${out%%$'\n'*}; DISKS=${DISKS%;}
    DRIVE_MAX_C=${out##*$'\n'}
}

# --- process attribution --------------------------------------------------
# Snapshot every process' cumulative CPU jiffies (own + reaped children, so a
# short-lived helper that already exited is charged to its parent) and I/O
# bytes in one awk pass. Format: pid comm own_cpu child_cpu rbytes wbytes. Kept as a ring of
# WINDOW_SNAPS files so attribution can look back over the controller's poll
# period, not just the last sample.
snapshot_procs() {
    # One awk process; files are opened with getline so a PID that exits
    # mid-scan is skipped instead of truncating the whole scan (gawk stops at
    # the first unreadable argv file, exit 0, so argv globs are NOT safe here).
    printf '%s\n' "$PROC"/[0-9]* 2>/dev/null | awk '
        {
            d = $0; n = split(d, parts, "/"); pid = parts[n]
            f = d "/stat"
            if ((getline s < f) > 0) {
                a = index(s, "("); b = 0
                for (i = length(s); i > 0; i--) if (substr(s, i, 1) == ")") { b = i; break }
                if (a && b) {
                    comm = substr(s, a + 1, b - a - 1); gsub(/[^A-Za-z0-9._-]/, "_", comm)   # comm is user-controlled
                    split(substr(s, b + 2), fl, " "); own = fl[12] + fl[13]; child = fl[14] + fl[15]
                    rb = 0; wb = 0; g = d "/io"
                    while ((getline l < g) > 0) {
                        if (l ~ /^read_bytes:/)       { split(l, x, " "); rb = x[2] }
                        else if (l ~ /^write_bytes:/) { split(l, x, " "); wb = x[2] }
                    }
                    close(g)
                    printf "%s %s %d %d %d %d\n", pid, comm, own, child, rb, wb
                }
            }
            close(f)
        }' > "$SNAP_DIR/new.tmp" 2>/dev/null
    [ -s "$SNAP_DIR/new.tmp" ] || return
    local i
    rm -f "$SNAP_DIR/$((WINDOW_SNAPS - 1))"
    for (( i = WINDOW_SNAPS - 2; i >= 0; i-- )); do
        [ -f "$SNAP_DIR/$i" ] && mv -f "$SNAP_DIR/$i" "$SNAP_DIR/$((i + 1))"
    done
    mv "$SNAP_DIR/new.tmp" "$SNAP_DIR/0"
}

oldest_snapshot() {            # prints the path of the oldest snapshot in the ring
    local i
    for (( i = WINDOW_SNAPS - 1; i >= 1; i-- )); do
        [ -f "$SNAP_DIR/$i" ] && { echo "$SNAP_DIR/$i"; return 0; }
    done
    return 1
}

container_of() {               # $1 = pid -> "docker:<name>" or "" (host)
    local cg id
    cg=$(cat "$PROC/$1/cgroup" 2>/dev/null) || return
    [[ "$cg" =~ docker[-/]([0-9a-f]{12,64}) ]] || return
    id=${BASH_REMATCH[1]}
    if [ -z "${CONTAINER_OF[$id]+x}" ]; then
        # Lazy cache fill: one docker ps per unknown id, only when a PWM change
        # names a containerised process. Bounded so a wedged docker daemon cannot
        # stall the sampling loop.
        while read -r cid cname; do CONTAINER_OF[$cid]=$cname; CONTAINER_OF[${cid:0:12}]=$cname; done \
            < <(timeout 3 docker ps --no-trunc --format '{{.ID}} {{.Names}}' 2>/dev/null)
        [ -z "${CONTAINER_OF[$id]+x}" ] && CONTAINER_OF[$id]="${id:0:12}"
    fi
    echo "docker:${CONTAINER_OF[$id]}"
}

peer_of() {                    # $1 = pid -> " <- 192.0.2.10" for its first established TCP peer, else ""
    command -v ss >/dev/null || return
    local peer
    peer=$(timeout 2 ss -Htnp state established 2>/dev/null | awk -v p="pid=$1," 'index($0, p) { print $4; exit }')
    peer=${peer%:*}; peer=${peer#[}; peer=${peer%]}
    [ -n "$peer" ] && printf ' <- %s' "${peer//[^0-9a-fA-F.:]/}"
}

# Top CPU consumers and top I/O writer between the oldest snapshot in the ring
# and the newest (up to WINDOW_SNAPS x INTERVAL seconds, covering the
# controller's 60 s poll period so the heat source is still in the window).
# Prints: "top CPU (60 s): comm[pid] 123% (docker:x), comm[pid] 40%; top write: comm[pid] 12.3 MB/s"
attribute_change() {
    local out="" line pid comm cpu rb wb pct mbs c old secs
    old=$(oldest_snapshot) && [ -s "$SNAP_DIR/0" ] || { echo "no process snapshot"; return; }
    secs=$(( $(date +%s) - $(stat -c %Y "$old") ))
    (( secs < 1 )) && secs=$INTERVAL
    local joined
    # Columns out: pid comm cpu% writeMB/s readMB/s flag. A child reaped inside
    # the window adds its WHOLE lifetime to the parent's cutime, so a child delta
    # larger than the window could physically hold is dropped and flagged "R".
    joined=$(awk -v tck="$CLK_TCK" -v secs="$secs" -v ncpu="$NCPUS" '
        NR == FNR { pown[$1] = $3; pchild[$1] = $4; prb[$1] = $5; pwb[$1] = $6; next }
        ($1 in pown) {
            d_own = $3 - pown[$1]; d_child = $4 - pchild[$1]; dw = $6 - pwb[$1]; dr = $5 - prb[$1]
            if (d_own < 0) d_own = 0; if (dw < 0) dw = 0; if (dr < 0) dr = 0
            flag = "-"; maxj = tck * secs * ncpu
            if (d_child < 0) d_child = 0
            if (d_child > maxj) { d_child = 0; flag = "R" }
            dc = d_own + d_child; if (dc > maxj) dc = maxj
            printf "%s %s %.0f %.2f %.2f %s\n", $1, $2, 100 * dc / (tck * secs), dw / 1048576 / secs, dr / 1048576 / secs, flag
        }' "$old" "$SNAP_DIR/0")
    # top 2 by CPU%
    # First entry is shown from 1% (a fan reacting to a 3 CPU-second burst is
    # exactly what we want to see); the second only if it is >= 5%.
    local flag k=0
    while read -r pid comm pct mbs _ flag; do
        k=$(( k + 1 ))
        if (( k == 1 )); then (( ${pct%.*} >= 1 )) || break; else (( ${pct%.*} >= 5 )) || break; fi
        c=$(container_of "$pid"); out+="${out:+, }${comm}[${pid}]$(peer_of "$pid") ${pct}%${c:+ ($c)}"
        [ "$flag" = "R" ] && out+=" (+reaped child, not counted)"
    done < <(sort -k3,3nr <<< "$joined" | awk 'NR <= 2')
    out="top CPU (${secs} s): ${out:-none >=1%}"
    # top 1 by write MB/s, then by read MB/s
    line=$(sort -k4,4nr <<< "$joined" | awk 'NR == 1')
    read -r pid comm _ mbs _ <<< "$line"
    if [ -n "$pid" ] && awk -v v="$mbs" 'BEGIN{exit !(v >= 1)}'; then
        c=$(container_of "$pid"); out+="; top write: ${comm}[${pid}]$(peer_of "$pid") ${mbs} MB/s${c:+ ($c)}"
    fi
    line=$(sort -k5,5nr <<< "$joined" | awk 'NR == 1')
    read -r pid comm _ _ mbs <<< "$line"
    if [ -n "$pid" ] && awk -v v="$mbs" 'BEGIN{exit !(v >= 1)}'; then
        c=$(container_of "$pid"); out+="; top read: ${comm}[${pid}]$(peer_of "$pid") ${mbs} MB/s${c:+ ($c)}"
    fi
    echo "$out"
}

action_log() {                 # append to the Status-tab action log, keep last 200 lines
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$ACTION_LOG"
    if (( $(wc -l < "$ACTION_LOG") > 200 )); then
        tail -n 200 "$ACTION_LOG" > "$ACTION_LOG.tmp" && mv "$ACTION_LOG.tmp" "$ACTION_LOG"
    fi
}

hottest_drive() {              # from the current DISKS/NVME strings: "cache2=58"
    tr ';' '\n' <<< "$1;$2" | awk -F= '$2 ~ /^[0-9]+$/ && $2+0 > m { m = $2+0; n = $1 } END { if (n != "") printf "%s=%s", n, m }'
}

log_pwm_change() {             # $1 = old pwm, $2 = new pwm
    local why who drive ev
    case "$FCP_SRC" in
        CPU)  why="FanCtrl Plus: CPU ${FCP_TEMP}°C (pkg ${PKG_C:-?}°C, core max ${CORE_MAX_C:-?}°C)" ;;
        Disk) drive=$(hottest_drive "$DISKS" "$NVME_STR"); why="FanCtrl Plus: disk ${FCP_TEMP}°C (hottest ${drive:-?})" ;;
        *)    why="FanCtrl Plus: ${FCP_TEMP:-?}°C ${FCP_SRC:-unknown source}" ;;
    esac
    who=$(attribute_change)
    ev="PWM $1 -> $2 ($(( $2 * 100 / 255 ))%, ${RPM:-?} rpm) | $why | system busy ${BUSY:-?}% | $who"
    action_log "$ev"
    echo "$TS $ev" >> "$STATE_DIR/pwm-events.buffer"
}

# --- output -----------------------------------------------------------------
write_status() {               # $1 = last_error ("" when healthy)
    printf '{"last_flush_ts":%s,"last_flush_file":"%s","rows_buffered":%s,"rows_written":%s,"last_error":"%s","logdir":"%s","drivers":"%s"}\n' \
        "${LAST_FLUSH_TS:-0}" "${LAST_FLUSH_FILE:-}" "$(wc -l < "$BUFFER" 2>/dev/null || echo 0)" \
        "${ROWS_WRITTEN:-0}" "${1//\"/}" "$LOGDIR" "${DRIVERS:-unknown}" > "$STATUS.tmp" && mv "$STATUS.tmp" "$STATUS"
}

# Asustor kernel drivers (from the Asustor Platform Driver plugin, one build per kernel). After an
# Unraid update without a matching build they are simply absent; record that, and every change of
# it, in the Action Log and the status file. Builtin tests only (runs every flush).
check_drivers() {
    local m miss=""
    for m in asustor asustor_it87 asustor_gpio_it87; do [ -d "$R/sys/module/$m" ] || miss="$miss${miss:+ }$m"; done
    local now=${miss:+missing: $miss}; now=${now:-ok}
    if [ "$now" != "${DRIVERS:-}" ]; then
        [ -n "${DRIVERS:-}" ] || [ "$now" != "ok" ] && action_log "Asustor drivers: $now (kernel ${KVER})"
        DRIVERS=$now
    fi
}

declare -A WARNED   # message -> 1 once the Action Log has it (no log spam every flush)
warn_once() { [ -n "${WARNED[$1]:-}" ] && return 0; WARNED[$1]=1; action_log "WARNING: $1"; }

# logdir_op append <name> | prune <days>, run on $LOGDIR without ever following a symlink: every
# path component from appdata down is opened O_NOFOLLOW (dirs also O_DIRECTORY) and the next one
# is opened through /proc/self/fd/<fd> of the previous, so a symlink planted or swapped in at any
# time (also between a check and the write) is never followed. append: stdin is appended to
# <name> (opened O_NOFOLLOW). prune: in the pinned hwlog dir, unlink regular files (lstat) named
# hwlog-YYYY-MM-DD.csv / pwm-events-YYYY-MM-DD.log older than <days>. Exit 3 = asustor-control
# or hwlog is not a real dir, 4 = the file is a symlink or cannot be opened, 5 = write failed.
logdir_op() {
    perl -e '
        use Fcntl; my ($op, $arg, $base, @parts) = @ARGV;
        sysopen(my $d, $base, O_RDONLY | O_DIRECTORY | O_NOFOLLOW) or exit 3;
        for my $p (@parts) {
            sysopen(my $n, "/proc/self/fd/" . fileno($d) . "/$p", O_RDONLY | O_DIRECTORY | O_NOFOLLOW) or exit 3;
            $d = $n;
        }
        my $dir = "/proc/self/fd/" . fileno($d);
        if ($op eq "prune") {
            opendir(my $dh, $dir) or exit 3;
            for my $e (readdir $dh) {
                next unless $e =~ /\A(?:hwlog-\d{4}-\d\d-\d\d\.csv|pwm-events-\d{4}-\d\d-\d\d\.log)\z/;
                my @st = lstat("$dir/$e") or next;
                next unless -f _ && (time - $st[9]) > $arg * 86400;
                unlink "$dir/$e";
            }
            exit 0;
        }
        sysopen(my $f, "$dir/$arg", O_WRONLY | O_APPEND | O_CREAT | O_NOFOLLOW, 0644) or exit 4;
        local $/; my $data = <STDIN>; $data = "" unless defined $data;
        my $w = syswrite($f, $data); exit 5 unless defined $w && $w == length $data;
    ' "$1" "$2" "$(dirname "$(dirname "$LOGDIR")")" "$(basename "$(dirname "$LOGDIR")")" "$(basename "$LOGDIR")"
}
append_nofollow() { logdir_op append "$1"; }
prune_logdir() { logdir_op prune "$RETAIN_DAYS" < /dev/null; }

flush_buffer() {
    [ -s "$BUFFER" ] || return 0
    if [ ! -d "$(dirname "$LOGDIR")" ] && [ ! -d "$R/mnt/user/appdata" ]; then
        write_status "appdata not mounted; buffering"; return 1
    fi
    # Owner/mode are set only when we create the dir; an existing dir is never chown/chmod-ed
    # (that would follow a symlink). The O_NOFOLLOW opens below are the actual guard.
    if [ ! -e "$LOGDIR" ] && [ ! -L "$LOGDIR" ] && [ ! -L "$(dirname "$LOGDIR")" ]; then
        mkdir -p "$(dirname "$LOGDIR")" 2>/dev/null
        mkdir -m 755 "$LOGDIR" 2>/dev/null && chown -h "$(id -u):$(id -g)" "$LOGDIR" 2>/dev/null
    fi
    local day; day=$(date +%F)
    local name="hwlog-$day.csv" file="$LOGDIR/hwlog-$day.csv" n rc=0
    n=$(wc -l < "$BUFFER")
    [ -n "${ASUSTOR_TEST_FN:-}" ] && [ -n "${ASUSTOR_TEST_BEFORE_WRITE:-}" ] && bash -c "$ASUSTOR_TEST_BEFORE_WRITE"   # tests: race
    if [ -e "$file" ] || [ -L "$file" ]; then
        append_nofollow "$name" < "$BUFFER" || rc=$?
    else
        { echo "$HEADER"; cat "$BUFFER"; } | append_nofollow "$name" || rc=$?
        # New day: apply retention to our own regular files only, in the pinned dir (see logdir_op).
        (( rc == 0 )) && prune_logdir
    fi
    if (( rc != 0 )); then
        case $rc in
            3) warn_once "$LOGDIR or its parent is a symlink or not a directory; behaviour log not written" ;;
            4) warn_once "$file is a symlink or cannot be opened; behaviour log not written" ;;
            *) warn_once "append to $file failed" ;;
        esac
        write_status "cannot write $file (code $rc); buffering"; return 1
    fi
    : > "$BUFFER"
    LAST_FLUSH_TS=$(date +%s); LAST_FLUSH_FILE=$file; ROWS_WRITTEN=$(( ${ROWS_WRITTEN:-0} + n ))
    if [ -s "$STATE_DIR/pwm-events.buffer" ]; then
        if append_nofollow "pwm-events-$day.log" < "$STATE_DIR/pwm-events.buffer"; then
            : > "$STATE_DIR/pwm-events.buffer"
        else
            warn_once "$LOGDIR/pwm-events-$day.log is a symlink or cannot be opened; events not written"
        fi
    fi
    write_status ""
}

sample_row() {                 # sets ROW (one detailed row) plus the globals the summary uses
    local pwm rpm khz thr nvme ts
    pwm=$(read_int "$HW/pwm1"); rpm=$(read_int "$HW/fan1_input")
    read_cpu_temps; khz=$(read_cpu_khz); thr=$(read_throttle); read_fcp; nvme=$(read_nvme); read_disks
    read_busy_pct
    ts=$(date +%s)
    PWM=$pwm; RPM=$rpm; TS=$ts; NVME_STR=$nvme
    ROW="$ts,${pwm},${rpm},${PKG_C},${CORE_MAX_C},${khz},${thr},${FCP_TEMP},${FCP_SRC},${nvme},${DISKS},${BUSY}"
}

# --- main -------------------------------------------------------------------
KVER=${ASUSTOR_KVER:-$(uname -r)}
find_fan_chip() { HW=$(find_hwmon_named 'it8*|nct*') || HW=$(find_hwmon_named 'it8*') || HW=$(find_hwmon_named 'nct*'); }
CT=$(find_hwmon_named 'coretemp') || CT=""

if [ "${ASUSTOR_ONESHOT:-0}" = "1" ]; then
    find_fan_chip || { echo "No supported fan hwmon chip found." >&2; exit 1; }
    echo "$HEADER"; sample_row; echo "$ROW"; exit 0
fi
case "${ASUSTOR_TEST_FN:-}" in
    flush_buffer|snapshot_procs|prune_logdir) "$ASUSTOR_TEST_FN"; exit $? ;;
    "") ;;
    *) echo "unknown ASUSTOR_TEST_FN" >&2; exit 2 ;;
esac

exec 9>"$PIDFILE.lock"
# Wait briefly: a predecessor's background sleep child can hold the lock for
# up to INTERVAL seconds after the predecessor itself has exited.
flock -w 15 9 || { echo "Another asustor-hwmon instance is running (lock held >15 s)." >&2; exit 1; }
echo $$ > "$PIDFILE"

# No fan chip usually means asustor_it87 has no build for this kernel. Stay up in a degraded
# mode (status + Action Log say why) and pick the chip up if it appears, instead of exiting.
check_drivers
if ! find_fan_chip; then
    trap '[ "$(cat "$PIDFILE" 2>/dev/null)" = "$$" ] && rm -f "$PIDFILE"; exit 0' INT TERM
    echo "asustor-hwmon: no fan sensor chip (drivers: $DRIVERS); waiting for it" >&2
    action_log "Hardware monitor: no fan sensor chip on kernel $KVER (drivers: $DRIVERS); not logging until it appears"
    write_status "no fan sensor chip (drivers: $DRIVERS)"
    until find_fan_chip; do
        [ "${ASUSTOR_DEGRADED_ONCE:-0}" = "1" ] && exit 0   # test hook
        sleep 60 9>&- & SLEEP_PID=$!; wait $SLEEP_PID
        check_drivers
    done
    action_log "Hardware monitor: fan sensor chip appeared ($HW), logging resumed"
fi

on_term() {
    [ -n "${SLEEP_PID:-}" ] && kill "$SLEEP_PID" 2>/dev/null
    flush_buffer
    # Only remove the pid file if it is still ours (a replacement may have started).
    [ "$(cat "$PIDFILE" 2>/dev/null)" = "$$" ] && rm -f "$PIDFILE"
    exit 0
}
trap on_term INT TERM

echo "asustor-hwmon started: fan chip $HW, coretemp ${CT:-none}, log dir $LOGDIR" >&2
i=0; PREV_PWM=""; PREV_TS=""
snapshot_procs
while true; do
    snapshot_procs
    sample_row
    echo "$ROW" >> "$BUFFER"
    if [ -n "$PREV_PWM" ] && [ -n "$PWM" ] && [ "$PWM" != "$PREV_PWM" ]; then
        log_pwm_change "$PREV_PWM" "$PWM"
    fi
    PREV_PWM=$PWM; PREV_TS=$TS
    if (( i % SUMMARY_EVERY == 0 )); then
        echo "$TS,${PWM:-0},${CORE_MAX_C:-0},${DRIVE_MAX_C:-0},${RPM:-0}" >> "$HISTORY"
        if (( $(wc -l < "$HISTORY") > MAX_LINES )); then
            tail -n "$MAX_LINES" "$HISTORY" > "$HISTORY.tmp" && mv "$HISTORY.tmp" "$HISTORY"
        fi
    fi
    if (( i % FLUSH_EVERY == FLUSH_EVERY - 1 )); then
        check_drivers
        flush_buffer || true
        if (( $(wc -l < "$BUFFER") > BUFFER_MAX )); then
            tail -n "$BUFFER_MAX" "$BUFFER" > "$BUFFER.tmp" && mv "$BUFFER.tmp" "$BUFFER"
        fi
        EV="$STATE_DIR/pwm-events.buffer"
        if [ -f "$EV" ] && (( $(wc -l < "$EV") > 2000 )); then
            tail -n 2000 "$EV" > "$EV.tmp" && mv "$EV.tmp" "$EV"
        fi
    fi
    i=$(( i + 1 ))
    # Sleep in the background so a TERM is handled immediately, not after the
    # sleep. 9>&- keeps the lock fd out of the child so it cannot hold the lock
    # after we exit; on_term also kills it.
    sleep "$INTERVAL" 9>&- & SLEEP_PID=$!; wait $SLEEP_PID
done
